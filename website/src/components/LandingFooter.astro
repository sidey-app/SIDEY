---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../i18n/landing";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const koreanHome = getRelativeLocaleUrl("ko");
---

<footer class="site-footer">
  {locale === "ko" ? (
    <>
      <div class="footer-commerce-policy" aria-label="배송 및 교환·환불 안내">
        <p><strong>배송일자</strong><span>디지털 상품으로 결제 완료 즉시 사용 가능</span></p>
        <p><strong>교환·환불</strong><span>결제 확인과 동시에 사용권 제공이 시작되어 단순 변심에 따른 환불은 불가합니다. 다만 미제공·계약 불일치·중복 또는 무단 결제 등 관련 법령상 사유가 확인되면 전액 환불합니다. <a href={`${base}ko/refund/`}>자세한 규정</a></span></p>
      </div>
      <dl class="footer-details footer-details-business">
        <div><dt>상호명</dt><dd>싸이디(SIDEY)</dd></div><div><dt>사업자등록번호</dt><dd>388-53-01259</dd></div><div><dt>연락처</dt><dd><a href="tel:+821092702973">010-9270-2973</a> · <a href="mailto:ryu200112@gmail.com">ryu200112@gmail.com</a></dd></div><div><dt>사업장 주소</dt><dd>경기도 용인시 기흥구 서천동로21번길 20-6</dd></div><div><dt>대표자명</dt><dd>류태현</dd></div><div><dt>통신판매업 신고번호</dt><dd>신고 면제(간이과세자)</dd></div>
      </dl>
      <div class="footer-row"><div class="footer-brand"><img src={`${base}assets/app-icon.png`} alt="" width="36" height="36"><strong>SIDEY</strong></div><div class="footer-links"><a href={`${base}ko/terms/`}>이용약관</a><a href={`${base}ko/privacy/`}>개인정보 처리방침</a><a href={`${base}ko/refund/`}>청약철회 및 환불 정책</a></div></div>
    </>
  ) : locale === "en" ? (
    <div class="footer-row"><div class="footer-brand"><img src={`${base}assets/app-icon.png`} alt="" width="38" height="38"><strong>SIDEY</strong></div><div class="footer-links"><a href={`${base}en/terms/`}>Terms of Use</a><a href={`${base}en/privacy/`}>Privacy Policy</a><a href={`${base}en/refund/`}>Refund Policy</a><a href={koreanHome} lang="ko" hreflang="ko">한국어</a></div></div>
  ) : (
    <div class="footer-row"><div class="footer-brand"><img src={`${base}assets/app-icon.png`} alt="" width="38" height="38"><strong>SIDEY</strong></div><div class="footer-links"><a href={`${base}ja/terms/`}>利用規約</a><a href={`${base}ja/privacy/`}>プライバシーポリシー</a><a href={`${base}ja/refund/`}>キャンセル・返金ポリシー</a><a href={koreanHome} lang="ko" hreflang="ko">한국어</a></div></div>
  )}
</footer>
