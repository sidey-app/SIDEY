<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Sidey.Platform.Windows.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sidey.Overlay/Sidey.Overlay.csproj" />
    <ProjectReference Include="../../src/Sidey.Presentation/Sidey.Presentation.csproj" />
    <ProjectReference Include="../../src/Sidey.Infrastructure/Sidey.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Sidey.Platform.Windows/Sidey.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../src/Sidey.App/Langs/*.json" Link="Langs/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Infrastructure/SupabaseBackendGateway.cs" Link="TestAssets/SupabaseBackendGateway.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Infrastructure/SupabaseRealtimeTransport.cs" Link="TestAssets/SupabaseRealtimeTransport.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.App/AppCoordinator.cs" Link="TestAssets/AppCoordinator.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Overlay/NativePixelWorldSession.cs" Link="TestAssets/NativePixelWorldSession.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Platform.Windows/NativeOverlayWindowThread.cs" Link="TestAssets/NativeOverlayWindowThread.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Platform.Windows/NativeOverlayWindow.cs" Link="TestAssets/NativeOverlayWindow.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.App/Sidey.App.csproj" Link="TestAssets/Sidey.App.csproj.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../src/Sidey.Overlay/Sidey.Overlay.csproj" Link="TestAssets/Sidey.Overlay.csproj.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../installer/Sidey.Setup/Sidey.Setup.nsi" Link="TestAssets/Sidey.Setup.nsi">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
