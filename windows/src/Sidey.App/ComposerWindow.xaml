<Window
    x:Class="Sidey.App.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid
      x:Name="ComposerRoot"
      Width="400"
      Height="56"
      Background="Transparent">
    <Border
        Margin="5"
        Padding="9,5"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        CornerRadius="15">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="CloseButton"
            Width="28"
            Height="34"
            Padding="0"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CloseCommand}"
            IsTabStop="False"
            ToolTipService.ToolTip="{i18n:I18n Key=composer.closeTooltip}">
          <FontIcon FontSize="13" Glyph="&#xE711;" />
        </Button>

        <TextBox
            x:Name="MessageInput"
            Grid.Column="1"
            Height="34"
            Padding="10,6,10,0"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            PlaceholderText="{i18n:I18n Key=composer.placeholder}"
            PreviewKeyDown="OnMessageInputPreviewKeyDown"
            Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center" />

        <Button
            x:Name="SendButton"
            Grid.Column="2"
            Width="28"
            Height="34"
            Padding="0"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding SendCommand}"
            IsTabStop="False"
            ToolTipService.ToolTip="{i18n:I18n Key=composer.sendTooltip}">
          <SymbolIcon Symbol="Send" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
