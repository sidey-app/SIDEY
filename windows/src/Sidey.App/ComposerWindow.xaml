<Window
    x:Class="Sidey.App.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="ComposerRoot"
      Width="400"
      Height="56"
      Padding="8"
      Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
    <TextBox
        x:Name="MessageInput"
        AcceptsReturn="True"
        KeyDown="OnMessageInputKeyDown"
        TextChanged="OnMessageInputTextChanged"
        PlaceholderText="메시지 입력 · Enter 전송 · Shift+Enter 줄바꿈 · Esc 닫기"
        TextWrapping="Wrap" />
  </Grid>
</Window>
