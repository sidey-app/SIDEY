<Window
    x:Class="Sidey.App.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Sidey.App.Localization">
    <Grid x:Name="HistoryRoot" Padding="20" RowSpacing="14" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="3">
        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Title}" />
        <TextBlock
            Text="{i18n:I18n Key=history.retentionNotice}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
      </StackPanel>

    <Grid Grid.Row="1">
      <ListView
          x:Name="HistoryList"
          ContainerContentChanging="OnHistoryContainerContentChanging"
          IsItemClickEnabled="False"
          ItemsSource="{Binding Items}"
          SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{ThemeResource SideyAccentBackground10Brush}" CornerRadius="12">
                  <Border Width="24" Height="24">
                    <Border.Clip>
                      <RectangleGeometry Rect="0,0,24,24" />
                    </Border.Clip>
                    <Image
                        Width="240"
                        Height="24"
                        HorizontalAlignment="Left"
                        Source="{Binding CharacterId, Converter={StaticResource CharacterImageConverter}}"
                        Stretch="Fill" />
                  </Border>
                </Border>
                <StackPanel Grid.Column="1" Spacing="5">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SenderName}" />
                    <Border
                        Grid.Column="1"
                        Padding="6,2"
                        Background="{ThemeResource SideyAccentBackground12Brush}"
                        CornerRadius="8"
                        Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SideyAccentForegroundBrush}" Text="{i18n:I18n Key=common.me}" />
                    </Border>
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding LocalTimeText}" />
                  </Grid>
                  <TextBlock IsTextSelectionEnabled="True" Text="{Binding Body}" TextWrapping="Wrap" />
                  <TextBlock
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Text="{i18n:I18n Key=history.sending}"
                      Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                      Text="{i18n:I18n Key=history.failed}"
                      Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.Footer>
          <Grid MinHeight="42">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{Binding IsLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ProgressRing Width="18" Height="18" IsActive="True" />
              <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=history.loadingMore}" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="5"
                Visibility="{Binding IsLoadMoreFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{i18n:I18n Key=history.loadMoreFailed}" />
              <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding LoadMoreErrorMessage}" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Center" Command="{Binding RetryLoadMoreCommand}" Content="{i18n:I18n Key=history.retry}" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{i18n:I18n Key=history.exhausted}"
                Visibility="{Binding IsExhaustedVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </ListView.Footer>
      </ListView>

      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsInitialLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ProgressRing Width="28" Height="28" IsActive="True" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=history.loading}" />
      </StackPanel>
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsInitialFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <FontIcon HorizontalAlignment="Center" FontSize="34" Glyph="&#xE814;" />
        <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=history.initialFailed}" />
        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding InitialErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Center" Command="{Binding RetryInitialCommand}" Content="{i18n:I18n Key=history.retry}" />
      </StackPanel>
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <FontIcon
            HorizontalAlignment="Center"
            FontSize="34"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="&#xE8BD;" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="{Binding EmptyMessage}" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding EmptyDescription}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
