<UserControl
    x:Class="Sidey.App.Controls.StoreProductArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
  <Grid>
    <Image
        x:Name="PreviewImage"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Stretch="None" />
    <Grid
        x:Name="CannonPreview"
        Width="92"
        Height="64"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Visibility="Collapsed">
      <Image x:Name="CannonEmitterImage" Width="48" Height="48" Stretch="None">
        <Image.RenderTransform>
          <TranslateTransform X="-8" Y="5" />
        </Image.RenderTransform>
      </Image>
      <Image x:Name="CannonballImage" Width="24" Height="24" Stretch="None">
        <Image.RenderTransform>
          <TranslateTransform X="24" Y="-11" />
        </Image.RenderTransform>
      </Image>
    </Grid>
    <Border
        x:Name="BubblePreview"
        Width="108"
        Height="40"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="White"
        BorderBrush="#3314171F"
        BorderThickness="1"
        CornerRadius="10"
        Visibility="Collapsed">
      <Image
          x:Name="BubbleDecoration"
          Width="16"
          Height="16"
          Margin="4"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Stretch="None" />
    </Border>
  </Grid>
</UserControl>
