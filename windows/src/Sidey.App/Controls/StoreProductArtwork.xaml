<UserControl
    x:Class="Sidey.App.Controls.StoreProductArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
  <Grid>
    <Image
        x:Name="PreviewImage"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Stretch="None" />
    <Border
        x:Name="DefaultBubblePreview"
        Width="128"
        Height="48"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="White"
        BorderBrush="#3314171F"
        BorderThickness="1"
        CornerRadius="12"
        Visibility="Collapsed" />
  </Grid>
</UserControl>
