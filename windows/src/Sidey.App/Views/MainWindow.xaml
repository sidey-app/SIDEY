<Window
    x:Class="Sidey.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid x:Name="MainRoot" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        BackRequested="OnTitleBarBackRequested"
        IsBackButtonEnabled="False"
        IsBackButtonVisible="True"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="OnTitleBarPaneToggleRequested"
        Title="SIDEY" />
    <NavigationView
        x:Name="RootNavigation"
        Grid.Row="1"
        Background="Transparent"
        CompactModeThresholdWidth="0"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="960"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="210"
        PaneDisplayMode="Auto"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" Icon="Contact" Tag="profile" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" Icon="People" Tag="groups" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" Icon="Shop" Tag="store" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" Icon="Setting" Tag="settings" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.about}, Mode=OneWay}" Tag="about" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.about}, Mode=OneWay}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid>
        <Grid>
          <ScrollViewer x:Name="HomePage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=profile.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.description}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel x:Name="ProfileCardContent" Spacing="18">
                  <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.nickname}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.nicknameDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBox MaxLength="8" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.nicknamePlaceholder}, Mode=OneWay}" Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button
                          Command="{Binding SaveProfileCommand}"
                          Content="{Binding Value, Source={i18n:I18n Key=profile.changeNickname}, Mode=OneWay}"
                          HorizontalAlignment="Right"
                          Style="{StaticResource AccentButtonStyle}"
                          ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=profile.changeNicknameTooltip}, Mode=OneWay}"
                          Visibility="{Binding HasNicknameChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.character}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.characterDescription}, Mode=OneWay}" />
                  </StackPanel>
                  <StackPanel>
                    <GridView
                      x:Name="CharacterSelector"
                      IsEnabled="{Binding IsSavingCharacter, Converter={StaticResource InverseBooleanConverter}}"
                      ItemsSource="{Binding CharacterSelections}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Transitions>
                      <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                    </GridView.Transitions>
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="5" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding SelectionStatus}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="116" HorizontalAlignment="Stretch">
                          <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                          <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="8" Spacing="7">
                            <Border Width="48" Height="48" HorizontalAlignment="Center">
                              <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Stretch" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                              BorderThickness="1.5"
                              CornerRadius="8"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border
                              Width="22"
                              Height="22"
                              Margin="6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                              CornerRadius="11"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="White"
                                Glyph="&#xE73E;" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <Grid Height="92" ColumnSpacing="12" Visibility="{Binding IsRemoteContentLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="68" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="52" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="64" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </Grid>
                  </StackPanel>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.bubble}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.bubbleDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid>
                    <GridView
                      x:Name="BubbleSelector"
                      ItemsSource="{Binding BubbleSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Transitions>
                      <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                    </GridView.Transitions>
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="4" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button Height="116" HorizontalAlignment="Stretch" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.ItemStatus="{Binding SelectionStatus}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="98">
                            <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="7">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="30" HorizontalAlignment="Center" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="22"
                                Height="22"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="11"
                                  Foreground="White"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <Grid Height="116" ColumnSpacing="12" Visibility="{Binding IsRemoteContentLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="72" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="62" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </Grid>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.throwable}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.throwableDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid>
                    <GridView
                      x:Name="ThrowableSelector"
                      ItemsSource="{Binding ThrowableSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Transitions>
                      <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                    </GridView.Transitions>
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="4" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button Height="116" HorizontalAlignment="Stretch" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.ItemStatus="{Binding SelectionStatus}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="98">
                            <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="7">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="30" HorizontalAlignment="Center" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="22"
                                Height="22"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="11"
                                  Foreground="White"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <Grid Height="116" ColumnSpacing="12" Visibility="{Binding IsRemoteContentLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="72" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="10"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="62" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </Grid>
                  </Grid>
                  <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.duplicateNotice}, Mode=OneWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="GroupsPage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <Grid x:Name="GroupsPageViewportHost">
              <StackPanel Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.description}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid>
                <Grid Visibility="{Binding IsRemoteContentLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <Grid.Transitions>
                    <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                  </Grid.Transitions>
                  <Border Style="{StaticResource SideySettingsCardStyle}" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                  <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <SymbolIcon HorizontalAlignment="Center" Symbol="People" />
                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyTitle}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  </Border>
                  <ListView IsItemClickEnabled="False" ItemsSource="{Binding Rooms}" SelectionMode="None" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                      <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition VerticalOffset="8" />
                        <ReorderThemeTransition />
                      </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="0" Style="{StaticResource SideySettingsCardStyle}">
                          <StackPanel Spacing="0">
                          <StackPanel.Transitions>
                            <TransitionCollection>
                              <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                              <RepositionThemeTransition />
                            </TransitionCollection>
                          </StackPanel.Transitions>
                          <Grid
                              Padding="20"
                              AutomationProperties.Name="{Binding ExpansionActionText}"
                              Background="Transparent"
                              ColumnSpacing="10"
                              PointerEntered="OnRoomHeaderPointerEntered"
                              PointerExited="OnRoomHeaderPointerExited"
                              Tag="{Binding ElementName=RoomExpandedBody}"
                              Tapped="OnRoomHeaderTapped"
                              ToolTipService.ToolTip="{Binding ExpansionActionText}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="RoomHeaderHoverBackground"
                                Grid.ColumnSpan="3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Margin="-20"
                                Opacity="0" />
                            <Border
                                Grid.ColumnSpan="3"
                                Margin="-8,-6"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0.28"
                                Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid
                                Grid.ColumnSpan="2"
                                ColumnSpacing="10"
                                IsHitTestVisible="False"
                                ToolTipService.ToolTip="{Binding ExpansionActionText}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="42" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                  <SymbolIcon Symbol="People" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                  <SymbolIcon Symbol="People" Foreground="#00C7BE" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="3">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.active}, Mode=OneWay}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <ProgressRing Width="18" Height="18" IsActive="{Binding IsSwitching}" Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding JoinCommand}" Content="{Binding JoinActionText}" IsEnabled="{Binding IsJoinEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.joinTooltip}, Mode=OneWay}" Visibility="{Binding CanJoin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding InviteCommand}" IsEnabled="{Binding IsInviteActionEnabled}" ToolTipService.ToolTip="{Binding InviteActionText}">
                                <Grid>
                                  <TextBlock Text="{Binding InviteActionText}" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                  <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding InviteActionText}" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                              <FontIcon
                                  x:Name="RoomExpansionChevron"
                                  Width="36"
                                  Height="36"
                                  FontSize="12"
                                  Glyph="&#xE70D;"
                                  IsHitTestVisible="False"
                                  Loaded="OnRoomExpansionChevronLoaded"
                                  RenderTransformOrigin="0.5,0.5"
                                  ToolTipService.ToolTip="{Binding ExpansionActionText}">
                                <FontIcon.RenderTransform><RotateTransform /></FontIcon.RenderTransform>
                              </FontIcon>
                            </StackPanel>
                          </Grid>

                          <Grid x:Name="RoomExpandedBody" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RenderTransform>
                              <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Row="1" Padding="70,18,20,20" Spacing="10">
                              <ItemsControl ItemsSource="{Binding Members}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid MinHeight="44" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="40" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36">
                                      <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <TextBlock Foreground="#FFF2AD1B" Text="♛" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                      <TextBlock VerticalAlignment="Center" Text="{Binding Nickname}" />
                                      <Border
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Background="{ThemeResource SideyAccentBackground12Brush}"
                                          CornerRadius="10"
                                          Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,-1,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
