<Window
    x:Class="Sidey.App.Views.StatusNoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="NoticeRoot"
      Width="400"
      Height="72"
      Background="{ThemeResource SideyComposerBackgroundBrush}">
    <Grid
        Padding="16,8"
        ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <FontIcon
          VerticalAlignment="Center"
          FontSize="20"
          Glyph="&#xE708;" />

      <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Spacing="2">
        <TextBlock
            x:Name="TitleText"
            AutomationProperties.LiveSetting="Polite"
            FontSize="14"
            FontWeight="SemiBold"
            MaxLines="1"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            x:Name="DetailText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="2"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
