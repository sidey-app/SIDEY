<Window
    x:Class="Sidey.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid x:Name="OnboardingRoot" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="DragRegion" Grid.Row="0" Canvas.ZIndex="10" Background="Transparent">
      <TextBlock
          Margin="20,0,0,0"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Text="{Binding Value, Source={i18n:I18n Key=window.settingsTitle}, Mode=OneWay}" />
    </Grid>

    <Grid
        Grid.RowSpan="2"
        Visibility="{Binding IsLanding, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#FFE2FBF2" />
          <GradientStop Offset="0.52" Color="#FFF9FBFF" />
          <GradientStop Offset="1" Color="#FFE1E8FF" />
        </LinearGradientBrush>
      </Grid.Background>
      <Ellipse
          Width="360"
          Height="360"
          Margin="-160,-170,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Fill="#49A8F3D5" />
      <Ellipse
          Width="320"
          Height="320"
          Margin="0,0,-130,-150"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Fill="#3A9FB5FF" />
      <StackPanel
          Width="560"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="14">
        <Border
            Width="132"
            Height="132"
            HorizontalAlignment="Center"
            Background="#BFFFFFFF"
            BorderBrush="#16000000"
            BorderThickness="1"
            CornerRadius="32">
          <Image x:Name="LandingIcon" Margin="14" Stretch="Uniform" />
        </Border>
        <TextBlock
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            FontFamily="Segoe UI Variable Display"
            FontSize="52"
            FontWeight="Bold"
            CharacterSpacing="70"
            Foreground="#E51B1B1F"
            Text="SIDEY" />
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="Segoe UI Variable Display"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="#A6202024"
            Text="{Binding Value, Source={i18n:I18n Key=onboarding.tagline}, Mode=OneWay}" />
        <TextBlock
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            Foreground="#8A202024"
            Text="{Binding Value, Source={i18n:I18n Key=onboarding.landingDescription}, Mode=OneWay}" />
        <Button
            MinWidth="150"
            HorizontalAlignment="Center"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=onboarding.getStarted}, Mode=OneWay}"
            Command="{Binding BeginCommand}"
            Content="{Binding Value, Source={i18n:I18n Key=onboarding.getStarted}, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>

    <Grid
        Grid.Row="1"
        Visibility="{Binding IsSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="48,18,48,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="1" />
          </Border>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepProfile}, Mode=OneWay}" />
        </StackPanel>
        <Rectangle Grid.Column="1" Width="70" Height="1" Margin="14,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="2" />
          </Border>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepGroup}, Mode=OneWay}" />
        </StackPanel>
        <Rectangle Grid.Column="3" Width="70" Height="1" Margin="14,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
          <Border Width="28" Height="28" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14">
            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White" Glyph="&#xE73E;" />
          </Border>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.stepComplete}, Mode=OneWay}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="42,0">
        <ScrollViewer Visibility="{Binding IsProfileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Width="650" HorizontalAlignment="Center" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock
                  AutomationProperties.HeadingLevel="Level1"
                  FontFamily="Segoe UI Variable Display"
                  FontSize="32"
                  FontWeight="SemiBold"
                  Text="{Binding Value, Source={i18n:I18n Key=onboarding.profileTitle}, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.profileDescription}, Mode=OneWay}" />
            </StackPanel>
            <Border Style="{StaticResource SideySettingsCardStyle}">
              <StackPanel Spacing="16">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=onboarding.character}, Mode=OneWay}" />
                <GridView
                    x:Name="OnboardingCharacterSelector"
                    ItemsSource="{Binding CharacterSelections}"
                    SelectedValuePath="Id"
                    SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                    SelectionMode="Single">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" ItemWidth="116" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                  <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Margin" Value="0" />
                    </Style>
                  </GridView.ItemContainerStyle>
                  <GridView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="94">
                        <StackPanel Padding="8" Spacing="6">
                          <Border Width="48" Height="48" HorizontalAlignment="Center">
                            <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                          </Border>
                          <TextBlock HorizontalAlignment="Center" Text="{Binding DisplayName}" />
                        </StackPanel>
                        <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Grid>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
                <TextBox
                    Header="{Binding Value, Source={i18n:I18n Key=onboarding.nickname}, Mode=OneWay}"
                    MaxLength="8"
                    PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.nicknamePlaceholder}, Mode=OneWay}"
                    Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding SaveProfileCommand}"
                    Content="{Binding Value, Source={i18n:I18n Key=common.next}, Mode=OneWay}"
                    IsEnabled="{Binding CanSaveProfile}"
                    Style="{StaticResource AccentButtonStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Visibility="{Binding IsGroupStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Width="650" HorizontalAlignment="Center" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock
                  AutomationProperties.HeadingLevel="Level1"
                  FontFamily="Segoe UI Variable Display"
                  FontSize="32"
                  FontWeight="SemiBold"
                  Text="{Binding Value, Source={i18n:I18n Key=onboarding.groupTitle}, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.groupDescription}, Mode=OneWay}" />
            </StackPanel>
            <Border Style="{StaticResource SideySettingsCardStyle}">
              <StackPanel Spacing="20">
                <RadioButtons Header="{Binding Value, Source={i18n:I18n Key=onboarding.groupPath}, Mode=OneWay}" MaxColumns="2" SelectedIndex="{Binding GroupPathIndex, Mode=TwoWay}">
                  <RadioButton Content="{Binding Value, Source={i18n:I18n Key=onboarding.createPath}, Mode=OneWay}" />
                  <RadioButton Content="{Binding Value, Source={i18n:I18n Key=onboarding.joinPath}, Mode=OneWay}" />
                </RadioButtons>
                <StackPanel Spacing="12" Visibility="{Binding GroupPathIndex, Converter={StaticResource ZeroToVisibilityConverter}}">
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=onboarding.roomName}, Mode=OneWay}" MaxLength="20" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.roomNamePlaceholder}, Mode=OneWay}" Text="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.createDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  <Button HorizontalAlignment="Right" Command="{Binding CreateRoomCommand}" Content="{Binding Value, Source={i18n:I18n Key=onboarding.create}, Mode=OneWay}" IsEnabled="{Binding CanCreateRoom}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <StackPanel Spacing="12" Visibility="{Binding GroupPathIndex, Converter={StaticResource OneToVisibilityConverter}}">
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCode}, Mode=OneWay}" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCodePlaceholder}, Mode=OneWay}" Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.inviteCaseNotice}, Mode=OneWay}" />
                  <Button HorizontalAlignment="Right" Command="{Binding JoinRoomCommand}" Content="{Binding Value, Source={i18n:I18n Key=onboarding.join}, Mode=OneWay}" IsEnabled="{Binding CanJoinRoom}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel
            Width="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18"
            Visibility="{Binding IsReadyStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Width="92" Height="92" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="46">
            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;" />
          </Border>
          <TextBlock
              HorizontalAlignment="Center"
              AutomationProperties.HeadingLevel="Level1"
              FontFamily="Segoe UI Variable Display"
              FontSize="34"
              FontWeight="SemiBold"
              Text="{Binding Value, Source={i18n:I18n Key=onboarding.completeTitle}, Mode=OneWay}" />
          <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=onboarding.completeDescription}, Mode=OneWay}" />
          <Button
              MinWidth="170"
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              Command="{Binding FinishCommand}"
              Content="{Binding Value, Source={i18n:I18n Key=onboarding.launch}, Mode=OneWay}"
              Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="42,16,42,26">
        <Button
            HorizontalAlignment="Left"
            Command="{Binding BackCommand}"
            Content="{Binding Value, Source={i18n:I18n Key=common.back}, Mode=OneWay}"
            Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
          <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionText}" />
        </StackPanel>
        <Button
            HorizontalAlignment="Right"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=common.skip}, Mode=OneWay}"
            Command="{Binding SkipGroupCommand}"
            Content="{Binding Value, Source={i18n:I18n Key=common.skip}, Mode=OneWay}"
            Visibility="{Binding IsGroupStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </Grid>
    </Grid>

    <InfoBar
        Grid.Row="1"
        Margin="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        IsClosable="False"
        IsOpen="{Binding HasError}"
        Message="{Binding ErrorMessage}"
        Severity="Error" />
  </Grid>
</Window>
