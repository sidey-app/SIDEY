<Window
    x:Class="Sidey.App.Views.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid
      x:Name="ComposerRoot"
      Width="400"
      Height="56"
      Background="{ThemeResource SideyComposerBackgroundBrush}">
    <Border
        Padding="14,10"
        Background="Transparent">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="CloseButton"
            Width="28"
            Height="34"
            Padding="0"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CloseCommand}"
            IsTabStop="False"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=composer.closeTooltip}, Mode=OneWay}">
          <FontIcon FontSize="13" Glyph="&#xE711;" />
        </Button>

        <TextBox
            x:Name="MessageInput"
            Grid.Column="1"
            Height="34"
            Padding="10,6,10,0"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            PlaceholderText="{Binding Value, Source={i18n:I18n Key=composer.placeholder}, Mode=OneWay}"
            PreviewKeyDown="OnMessageInputPreviewKeyDown"
            Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
          </TextBox.Resources>
        </TextBox>

        <Button
            x:Name="SendButton"
            Grid.Column="2"
            Width="28"
            Height="34"
            Padding="0"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding SendCommand}"
            IsTabStop="False"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=composer.sendTooltip}, Mode=OneWay}">
          <SymbolIcon Symbol="Send" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
