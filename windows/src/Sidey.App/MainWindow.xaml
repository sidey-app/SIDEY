<Window
    x:Class="Sidey.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid x:Name="MainRoot" Background="Transparent">
    <NavigationView
        x:Name="RootNavigation"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="210"
        PaneClosed="OnNavigationPaneClosed"
        PaneDisplayMode="Left"
        PaneOpened="OnNavigationPaneOpened"
        PaneTitle="SIDEY"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{i18n:I18n Key=navigation.profile}" Icon="Contact" Tag="profile" ToolTipService.ToolTip="{i18n:I18n Key=navigation.profile}" />
        <NavigationViewItem Content="{i18n:I18n Key=navigation.groups}" Icon="People" Tag="groups" ToolTipService.ToolTip="{i18n:I18n Key=navigation.groups}" />
        <NavigationViewItem Content="{i18n:I18n Key=navigation.store}" Icon="Shop" Tag="store" ToolTipService.ToolTip="{i18n:I18n Key=navigation.store}" />
        <NavigationViewItem Content="{i18n:I18n Key=navigation.settings}" Icon="Setting" Tag="settings" ToolTipService.ToolTip="{i18n:I18n Key=navigation.settings}" />
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <Border Margin="12" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="9" Height="9" Fill="{Binding IsConnected, Converter={StaticResource ConnectionBrushConverter}}" />
            <TextBlock Text="{Binding ConnectionText}" />
          </StackPanel>
        </Border>
      </NavigationView.PaneFooter>

      <Grid>
        <Grid Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch">
          <ScrollViewer x:Name="HomePage">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:I18n Key=profile.title}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=profile.description}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="18">
                  <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=profile.nickname}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=profile.nicknameDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Grid.Column="1" MaxLength="8" PlaceholderText="{i18n:I18n Key=onboarding.nicknamePlaceholder}" Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=profile.character}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=profile.characterDescription}" />
                  </StackPanel>
                  <GridView
                      x:Name="CharacterSelector"
                      Loaded="OnCharacterSelectorLoaded"
                      ItemsSource="{Binding CharacterSelections}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                      SelectionMode="Single"
                      SizeChanged="OnCharacterSelectorSizeChanged">
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Grid MinHeight="96">
                          <StackPanel Padding="8" Spacing="7">
                            <Border Width="48" Height="48" HorizontalAlignment="Center">
                              <Border.Clip><RectangleGeometry Rect="0,0,48,48" /></Border.Clip>
                              <Image Width="480" Height="48" HorizontalAlignment="Left" Source="{Binding CharacterId, Converter={StaticResource CharacterImageConverter}}" Stretch="Fill" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                              BorderThickness="2"
                              CornerRadius="8"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border
                              Width="22"
                              Height="22"
                              Margin="6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                              CornerRadius="11"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="White"
                                Glyph="&#xE73E;" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                  <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{i18n:I18n Key=profile.duplicateNotice}" />
                  <Button Command="{Binding SaveProfileCommand}" Content="{i18n:I18n Key=profile.save}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{i18n:I18n Key=profile.saveTooltip}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="GroupsPage" Visibility="Collapsed">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:I18n Key=groups.title}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=groups.description}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="12">
                  <StackPanel HorizontalAlignment="Center" Spacing="8" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <SymbolIcon HorizontalAlignment="Center" Symbol="People" />
                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=groups.emptyTitle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=groups.emptyDescription}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <ListView IsItemClickEnabled="False" ItemsSource="{Binding Rooms}" SelectionMode="None" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemContainerTransitions>
                      <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition VerticalOffset="8" />
                        <ReorderThemeTransition />
                      </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Padding="4" Spacing="12">
                          <StackPanel.Transitions>
                            <TransitionCollection>
                              <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                              <RepositionThemeTransition />
                            </TransitionCollection>
                          </StackPanel.Transitions>
                          <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.ColumnSpan="3"
                                Margin="-8,-6"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0.28"
                                Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Grid.ColumnSpan="2"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleCommand}"
                                ToolTipService.ToolTip="{Binding ExpansionActionText}">
                              <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="42" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon HorizontalAlignment="Center" Symbol="People" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="3">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{i18n:I18n Key=groups.active}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <ProgressRing Width="18" Height="18" IsActive="{Binding IsSwitching}" Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding JoinCommand}" Content="{Binding JoinActionText}" IsEnabled="{Binding IsJoinEnabled}" ToolTipService.ToolTip="{i18n:I18n Key=groups.joinTooltip}" Visibility="{Binding CanJoin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding InviteCommand}" Content="{Binding InviteActionText}" IsEnabled="{Binding IsInviteActionEnabled}" ToolTipService.ToolTip="{Binding InviteActionText}" />
                              <Button
                                  Width="36"
                                  Height="36"
                                  Command="{Binding ToggleCommand}"
                                  ToolTipService.ToolTip="{Binding ExpansionActionText}">
                                <FontIcon FontSize="12" Glyph="{Binding ExpansionGlyph}" />
                              </Button>
                            </StackPanel>
                          </Grid>

                          <StackPanel Padding="50,0,0,0" Spacing="10" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Transitions>
                              <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="True" />
                                <RepositionThemeTransition />
                              </TransitionCollection>
                            </StackPanel.Transitions>
                            <ItemsControl ItemsSource="{Binding Members}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid MinHeight="44" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="40" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36">
                                      <Border.Clip><RectangleGeometry Rect="0,0,36,36" /></Border.Clip>
                                      <Image Width="360" Height="36" HorizontalAlignment="Left" Source="{Binding CharacterId, Converter={StaticResource CharacterImageConverter}}" Stretch="Fill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <TextBlock Foreground="#FFF2AD1B" Text="♛" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                      <TextBlock VerticalAlignment="Center" Text="{Binding Nickname}" />
                                      <Border
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Background="{ThemeResource AccentFillColorDefaultBrush}"
                                          CornerRadius="10"
                                          Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,-1,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{i18n:I18n Key=common.me}" />
                                      </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding RemoveCommand}" Content="{i18n:I18n Key=groups.removeMember}" ToolTipService.ToolTip="{i18n:I18n Key=groups.removeMemberTooltip}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Button Command="{Binding RenameCommand}" Content="{i18n:I18n Key=groups.rename}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{i18n:I18n Key=groups.renameTooltip}" />
                              <Button Command="{Binding DeleteCommand}" Content="{i18n:I18n Key=groups.delete}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{i18n:I18n Key=groups.deleteTooltip}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=groups.createTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=groups.createDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{i18n:I18n Key=groups.roomName}" IsEnabled="{Binding AreGroupMutationsEnabled}" MaxLength="20" PlaceholderText="{i18n:I18n Key=groups.roomNamePlaceholder}" Text="{Binding CreateRoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{Binding CreateRoomCommand}" Content="{Binding CreateRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{i18n:I18n Key=groups.createTooltip}" />
                </Grid>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=groups.joinTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=groups.joinDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{i18n:I18n Key=groups.inviteCode}" IsEnabled="{Binding AreGroupMutationsEnabled}" PlaceholderText="{i18n:I18n Key=groups.inviteCode}" Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{Binding JoinRoomCommand}" Content="{Binding JoinRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{i18n:I18n Key=groups.joinByCodeTooltip}" />
                </Grid>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="StorePage" Visibility="Collapsed">
            <StackPanel Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:I18n Key=store.title}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=store.description}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                  <FontIcon FontSize="40" Glyph="&#xE719;" />
                  <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=store.comingSoon}" HorizontalAlignment="Center" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=store.comingSoonDescription}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{i18n:I18n Key=settings.generalTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.generalDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="14">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.overlay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.overlayDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsOverlayVisible, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{i18n:I18n Key=settings.overlayTooltip}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.startup}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.startupDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding StartAtLogin, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{i18n:I18n Key=settings.startupTooltip}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=settings.displayTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.displayDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="14">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.quietMode}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.quietModeDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsQuietMode, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{i18n:I18n Key=settings.quietModeTooltip}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.rightClickThrow}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.rightClickThrowDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding RequiresRightClickToThrow, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{i18n:I18n Key=settings.rightClickThrowTooltip}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.offlineMembers}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.offlineMembersDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding ShowOfflineMembers, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{i18n:I18n Key=settings.offlineMembersTooltip}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=settings.updateTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.updateDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.checkUpdate}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.checkUpdateDescription}" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Content="{i18n:I18n Key=settings.checkNow}" VerticalAlignment="Center" ToolTipService.ToolTip="{i18n:I18n Key=settings.checkNowTooltip}" />
                </Grid>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=settings.worldTitle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.worldDescription}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.edge}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.edgeDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedEdgeIndex, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:I18n Key=settings.edgeTooltip}">
                      <ComboBoxItem Content="{i18n:I18n Key=settings.edgeBottom}" /><ComboBoxItem Content="{i18n:I18n Key=settings.edgeLeft}" /><ComboBoxItem Content="{i18n:I18n Key=settings.edgeRight}" /><ComboBoxItem Content="{i18n:I18n Key=settings.edgeTop}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.span}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.spanDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSpanIndex, Mode=TwoWay}" ToolTipService.ToolTip="{i18n:I18n Key=settings.spanTooltip}">
                      <ComboBoxItem Content="1/3" /><ComboBoxItem Content="1/2" /><ComboBoxItem Content="{i18n:I18n Key=settings.spanFull}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{i18n:I18n Key=settings.monitor}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{i18n:I18n Key=settings.monitorDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Monitors}" SelectedValue="{Binding SelectedMonitorIdentifier, Mode=TwoWay}" SelectedValuePath="Identifier" ToolTipService.ToolTip="{i18n:I18n Key=settings.monitorTooltip}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SideySettingsCardStyle}" Visibility="{Binding IsValidationMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                  <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{i18n:I18n Key=settings.rendererMetrics}" />
                  <TextBlock Text="{Binding ValidationMetricsText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ValidationPathText}" TextWrapping="Wrap" />
                  <Button Command="{Binding ExportValidationMetricsCommand}" Content="{i18n:I18n Key=settings.exportMetrics}" HorizontalAlignment="Left" ToolTipService.ToolTip="{i18n:I18n Key=settings.exportMetricsTooltip}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsClosable="True" IsOpen="False" />
      </Grid>
    </NavigationView>
    <Ellipse
        x:Name="CompactConnectionDot"
        Width="9"
        Height="9"
        Margin="20,0,0,25"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Fill="{Binding IsConnected, Converter={StaticResource ConnectionBrushConverter}}"
        IsHitTestVisible="False"
        Visibility="Collapsed" />
  </Grid>
</Window>
