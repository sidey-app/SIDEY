<Window
    x:Class="Sidey.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="SIDEY" />
      <TextBlock Text="Windows 네이티브 햄스터 slice 준비 중" TextWrapping="Wrap" />
      <InfoBar
          IsOpen="True"
          IsClosable="False"
          Severity="Informational"
          Message="이 빌드는 내부 플랫폼 검증용이며 아직 공개 alpha가 아님." />
    </StackPanel>
  </Grid>
</Window>
