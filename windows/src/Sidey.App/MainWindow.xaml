<Window
    x:Class="Sidey.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid x:Name="MainRoot" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        BackRequested="OnTitleBarBackRequested"
        IsBackButtonEnabled="False"
        IsBackButtonVisible="True"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="OnTitleBarPaneToggleRequested"
        Title="SIDEY">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="/Assets/Icons/SideyAppIcon-20.png" />
      </TitleBar.IconSource>
    </TitleBar>
    <NavigationView
        x:Name="RootNavigation"
        Grid.Row="1"
        Background="Transparent"
        CompactModeThresholdWidth="0"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="960"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="210"
        PaneClosed="OnNavigationPaneClosed"
        PaneClosing="OnNavigationPaneClosing"
        PaneDisplayMode="Auto"
        PaneOpened="OnNavigationPaneOpened"
        PaneOpening="OnNavigationPaneOpening"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" Icon="Contact" Tag="profile" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" Icon="People" Tag="groups" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" Icon="Shop" Tag="store" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" Icon="Setting" Tag="settings" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" />
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <Grid x:Name="ConnectionStatusRoot" Width="210" Height="52" HorizontalAlignment="Left">
          <Border
              x:Name="ExpandedConnectionStatus"
              Margin="12,4"
              Padding="12,8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              IsHitTestVisible="False">
            <Border.OpacityTransition>
              <ScalarTransition Duration="0:0:0.16" />
            </Border.OpacityTransition>
            <StackPanel
                x:Name="ExpandedConnectionContent"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
              <Ellipse
                  Width="9"
                  Height="9"
                  VerticalAlignment="Center"
                  Fill="{Binding IsConnected, Converter={StaticResource ConnectionBrushConverter}}" />
              <TextBlock
                  Margin="0,2,0,0"
                  VerticalAlignment="Center"
                  LineHeight="20"
                  LineStackingStrategy="BlockLineHeight"
                  Text="{Binding ConnectionText}" />
            </StackPanel>
          </Border>
          <Border
              x:Name="CompactConnectionStatus"
              Width="40"
              Height="44"
              Margin="4"
              HorizontalAlignment="Left"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              IsHitTestVisible="False"
              Opacity="0">
            <Border.OpacityTransition>
              <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <Ellipse
                x:Name="CompactConnectionDot"
                Width="9"
                Height="9"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{Binding IsConnected, Converter={StaticResource ConnectionBrushConverter}}" />
          </Border>
        </Grid>
      </NavigationView.PaneFooter>

      <Grid>
        <Grid Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch">
          <ScrollViewer x:Name="HomePage">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=profile.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.description}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel x:Name="ProfileCardContent" Spacing="18">
                  <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.nickname}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.nicknameDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBox MaxLength="8" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.nicknamePlaceholder}, Mode=OneWay}" Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button
                          Command="{Binding SaveProfileCommand}"
                          Content="{Binding Value, Source={i18n:I18n Key=profile.changeNickname}, Mode=OneWay}"
                          HorizontalAlignment="Right"
                          Style="{StaticResource AccentButtonStyle}"
                          ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=profile.changeNicknameTooltip}, Mode=OneWay}"
                          Visibility="{Binding HasNicknameChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.character}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.characterDescription}, Mode=OneWay}" />
                  </StackPanel>
                  <GridView
                      x:Name="CharacterSelector"
                      IsEnabled="{Binding IsSavingCharacter, Converter={StaticResource InverseBooleanConverter}}"
                      ItemsSource="{Binding CharacterSelections}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="5" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="116" HorizontalAlignment="Stretch">
                          <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="8" Spacing="7">
                            <Border Width="48" Height="48" HorizontalAlignment="Center">
                              <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Stretch" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                              BorderThickness="1.5"
                              CornerRadius="8"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border
                              Width="22"
                              Height="22"
                              Margin="6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                              CornerRadius="11"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="White"
                                Glyph="&#xE73E;" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.bubble}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.bubbleDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <GridView
                      x:Name="BubbleSelector"
                      ItemsSource="{Binding BubbleSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="4" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button Height="116" HorizontalAlignment="Stretch" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="98">
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="7">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="30" HorizontalAlignment="Center" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="22"
                                Height="22"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="11"
                                  Foreground="White"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.throwable}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.throwableDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <GridView
                      x:Name="ThrowableSelector"
                      ItemsSource="{Binding ThrowableSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Width="{Binding ActualWidth, ElementName=ProfileCardContent}">
                    <GridView.Resources>
                      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:FixedColumnPanel ColumnCount="4" ItemHeight="116" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button Height="116" HorizontalAlignment="Stretch" Padding="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="98">
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="7">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="30" HorizontalAlignment="Center" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="22"
                                Height="22"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="11"
                                  Foreground="White"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                  </GridView>
                  <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.duplicateNotice}, Mode=OneWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="GroupsPage" Visibility="Collapsed">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.description}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="12">
                  <StackPanel HorizontalAlignment="Center" Spacing="8" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <SymbolIcon HorizontalAlignment="Center" Symbol="People" />
                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyTitle}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <ListView IsItemClickEnabled="False" ItemsSource="{Binding Rooms}" SelectionMode="None" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemContainerTransitions>
                      <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition VerticalOffset="8" />
                        <ReorderThemeTransition />
                      </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,16" Padding="4" Spacing="12">
                          <StackPanel.Transitions>
                            <TransitionCollection>
                              <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                              <RepositionThemeTransition />
                            </TransitionCollection>
                          </StackPanel.Transitions>
                          <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.ColumnSpan="3"
                                Margin="-8,-6"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0.28"
                                Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Grid.ColumnSpan="2"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleCommand}"
                                ToolTipService.ToolTip="{Binding ExpansionActionText}">
                              <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="42" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                  <SymbolIcon Symbol="People" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                  <SymbolIcon Symbol="People" Foreground="#00C7BE" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="3">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.active}, Mode=OneWay}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <ProgressRing Width="18" Height="18" IsActive="{Binding IsSwitching}" Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding JoinCommand}" Content="{Binding JoinActionText}" IsEnabled="{Binding IsJoinEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.joinTooltip}, Mode=OneWay}" Visibility="{Binding CanJoin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding InviteCommand}" IsEnabled="{Binding IsInviteActionEnabled}" ToolTipService.ToolTip="{Binding InviteActionText}">
                                <Grid>
                                  <TextBlock Text="{Binding InviteActionText}" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                  <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding InviteActionText}" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                              <Button
                                  Width="36"
                                  Height="36"
                                  Command="{Binding ToggleCommand}"
                                  ToolTipService.ToolTip="{Binding ExpansionActionText}">
                                <FontIcon FontSize="12" Glyph="{Binding ExpansionGlyph}" />
                              </Button>
                            </StackPanel>
                          </Grid>

                          <StackPanel Padding="50,0,0,0" Spacing="10" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Transitions>
                              <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="True" />
                                <RepositionThemeTransition />
                              </TransitionCollection>
                            </StackPanel.Transitions>
                            <ItemsControl ItemsSource="{Binding Members}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid MinHeight="44" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="40" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36">
                                      <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <TextBlock Foreground="#FFF2AD1B" Text="♛" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                      <TextBlock VerticalAlignment="Center" Text="{Binding Nickname}" />
                                      <Border
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Background="{ThemeResource SideyAccentBackground12Brush}"
                                          CornerRadius="10"
                                          Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,-1,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SideyAccentForegroundBrush}"
                                            Text="{Binding Value, Source={i18n:I18n Key=common.me}, Mode=OneWay}" />
                                      </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding RemoveCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.removeMember}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.removeMemberTooltip}, Mode=OneWay}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Command="{Binding LeaveCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.leave}, Mode=OneWay}" IsEnabled="{Binding AreRoomActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.leaveTooltip}, Mode=OneWay}" />
                              <Button Command="{Binding RenameCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.rename}, Mode=OneWay}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.renameTooltip}, Mode=OneWay}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding DeleteCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.delete}, Mode=OneWay}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.deleteTooltip}, Mode=OneWay}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.createTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.createDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=groups.roomName}, Mode=OneWay}" IsEnabled="{Binding AreGroupMutationsEnabled}" MaxLength="20" PlaceholderText="{Binding Value, Source={i18n:I18n Key=groups.roomNamePlaceholder}, Mode=OneWay}" Text="{Binding CreateRoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{Binding CreateRoomCommand}" Content="{Binding CreateRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.createTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.joinTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.joinDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=groups.inviteCode}, Mode=OneWay}" IsEnabled="{Binding AreGroupMutationsEnabled}" PlaceholderText="{Binding Value, Source={i18n:I18n Key=groups.inviteCode}, Mode=OneWay}" Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{Binding JoinRoomCommand}" Content="{Binding JoinRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.joinByCodeTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="StorePage" Visibility="Collapsed">
            <StackPanel Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=store.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=store.description}, Mode=OneWay}" />
              </StackPanel>
              <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=store.productKind}, Mode=OneWay}" />
                  <SelectorBar
                      x:Name="StoreKindSelector"
                      SelectionChanged="OnStoreKindSelectionChanged">
                    <SelectorBarItem IsSelected="True" Text="{Binding Value, Source={i18n:I18n Key=store.kindCharacter}, Mode=OneWay}" />
                    <SelectorBarItem Text="{Binding Value, Source={i18n:I18n Key=store.kindBubble}, Mode=OneWay}" />
                    <SelectorBarItem Text="{Binding Value, Source={i18n:I18n Key=store.kindThrowable}, Mode=OneWay}" />
                  </SelectorBar>
                </StackPanel>
                <ToggleButton
                    x:Name="StoreFilterToggle"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnStoreFilterToggleClick"
                    ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=store.filter}, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                    <TextBlock Text="{Binding Value, Source={i18n:I18n Key=store.filter}, Mode=OneWay}" />
                    <FontIcon x:Name="StoreFilterChevron" FontSize="12" Glyph="&#xE70D;" />
                  </StackPanel>
                </ToggleButton>
                <Border
                    x:Name="StoreFilterPanel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Padding="16"
                    Style="{StaticResource SideySettingsCardStyle}"
                    Visibility="Collapsed">
                  <Border.Transitions>
                    <TransitionCollection>
                      <EntranceThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                  </Border.Transitions>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="{Binding Value, Source={i18n:I18n Key=store.search}, Mode=OneWay}"
                        PlaceholderText="{Binding Value, Source={i18n:I18n Key=store.searchPlaceholder}, Mode=OneWay}"
                        Text="{Binding StoreSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=store.sort}, Mode=OneWay}" />
                      <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedStoreSortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortCatalog}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortPriceAscending}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortPriceDescending}, Mode=OneWay}" />
                      </ComboBox>
                    </StackPanel>
                    <CheckBox
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Content="{Binding Value, Source={i18n:I18n Key=store.hideOwned}, Mode=OneWay}"
                        IsChecked="{Binding HidesOwnedStoreProducts, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </Grid>
              <Grid x:Name="StoreResultsHost" MinHeight="220">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding HasVisibleStoreProducts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE735;" />
                  <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=store.emptyTitle}, Mode=OneWay}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=store.emptyDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsRepeater
                    ItemsSource="{Binding VisibleStoreProducts}"
                    Visibility="{Binding HasVisibleStoreProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="5"
                        MinColumnSpacing="12"
                        MinItemHeight="204"
                        MinItemWidth="150"
                        MinRowSpacing="12"
                        Orientation="Horizontal" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <Border
                          MinHeight="204"
                          Padding="10"
                          CornerRadius="12"
                          Style="{StaticResource SideySettingsCardStyle}">
                        <Grid RowSpacing="8">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="116" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Border Background="{ThemeResource SideyAccentBackground10Brush}" CornerRadius="12">
                            <Grid>
                              <controls:StoreProductArtwork
                                  Margin="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ProductKind="{Binding Kind}"
                                  CatalogItemId="{Binding CatalogItemId}"
                                  CharacterId="{Binding CharacterId}" />
                              <Border
                                  Margin="7"
                                  Padding="7,4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="12"
                                  Visibility="{Binding IsPreviewOnlyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <FontIcon FontSize="11" Glyph="&#xE72E;" />
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                          <TextBlock
                              Grid.Row="1"
                              HorizontalAlignment="Center"
                              FontSize="14"
                              FontWeight="SemiBold"
                              MaxLines="2"
                              Text="{Binding DisplayName}"
                              TextAlignment="Center"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Grid.Row="2"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              FontSize="12"
                              Text="{Binding FormattedPrice}" />
                          <Button
                              Grid.RowSpan="3"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              AutomationProperties.Name="{Binding DisplayName}"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{Binding PreviewCommand}"
                              ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=store.openPreview}, Mode=OneWay}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </Grid>
              <TextBlock
                  HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{Binding Value, Source={i18n:I18n Key=store.comingSoonDescription}, Mode=OneWay}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
            <StackPanel Spacing="26">
              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.generalTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.generalDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="14">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.overlay}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.overlayDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsOverlayVisible, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.overlayTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.startup}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.startupDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding StartAtLogin, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.startupTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.displayTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.displayDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="14">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.quietMode}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.quietModeDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsQuietMode, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.quietModeTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrow}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrowDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding RequiresRightClickToThrow, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrowTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.offlineMembers}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.offlineMembersDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding ShowOfflineMembers, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.offlineMembersTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.updateTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.updateDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionText}" />
                    <Grid>
                      <TextBlock
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="{Binding LastUpdateCheckText}"
                          Visibility="{Binding HasUpdateActivity, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                      <StackPanel
                          Orientation="Horizontal"
                          Spacing="8"
                          Visibility="{Binding HasUpdateActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressRing Width="16" Height="16" IsActive="{Binding HasUpdateActivity}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding UpdateActivityText}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <HyperlinkButton HorizontalAlignment="Left" Padding="0" Command="{Binding OpenReleaseNotesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.releaseNotes}, Mode=OneWay}" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.checkUpdate}, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.checkNowTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.worldTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.worldDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.edge}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.edgeDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedEdgeIndex, Mode=TwoWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.edgeTooltip}, Mode=OneWay}">
                      <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeBottom}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeLeft}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeRight}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeTop}, Mode=OneWay}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.span}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.spanDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSpanIndex, Mode=TwoWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.spanTooltip}, Mode=OneWay}">
                      <ComboBoxItem Content="1/3" /><ComboBoxItem Content="1/2" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.spanFull}, Mode=OneWay}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.monitor}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.monitorDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Monitors}" SelectedValue="{Binding SelectedMonitorIdentifier, Mode=TwoWay}" SelectedValuePath="Identifier" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.monitorTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SideySettingsCardStyle}" Visibility="{Binding IsValidationMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                  <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.rendererMetrics}, Mode=OneWay}" />
                  <TextBlock Text="{Binding ValidationMetricsText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ValidationPathText}" TextWrapping="Wrap" />
                  <Button Command="{Binding ExportValidationMetricsCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.exportMetrics}, Mode=OneWay}" HorizontalAlignment="Left" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.exportMetricsTooltip}, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.language}, Mode=OneWay}" />
                    <TextBlock x:Name="LanguageDescriptionText" Text="{Binding Value, Source={i18n:I18n Key=settings.languageDescription}, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <ComboBox x:Name="LanguageComboBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=settings.language}, Mode=OneWay}"
                            IsEnabled="{Binding IsLanguageSelectionEnabled}"
                            SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="한국어" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="日本語" />
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsClosable="True" IsOpen="False" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
