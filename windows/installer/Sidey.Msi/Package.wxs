<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="SIDEY"
      Manufacturer="SIDEY"
      Version="$(ProductVersion)"
      UpgradeCode="E744D02B-C3CF-41CE-A4C9-9BA1EB10C6B9"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation Description="SIDEY Windows alpha" Manufacturer="SIDEY" />
    <MajorUpgrade
        AllowDowngrades="no"
        DowngradeErrorMessage="A newer version of SIDEY is already installed."
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="LEGACYUSERINSTALLVERSION">
      <RegistrySearch
          Id="LegacyPerUserInstallSearch"
          Root="HKCU"
          Key="Software\SIDEY\Installer"
          Name="InstalledVersion"
          Type="raw" />
    </Property>
    <Launch Condition="VersionNT64" Message="SIDEY requires 64-bit Windows." />
    <Launch
        Condition="NOT LEGACYUSERINSTALLVERSION OR Installed"
        Message="The per-user SIDEY alpha must be uninstalled before installing this all-users version. Your SIDEY settings and session will be preserved." />
    <util:RestartResource ProcessName="SIDEY.exe" />
    <util:RestartResource ProcessName="SIDEY.Host.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SIDEY">
        <Directory Id="LANGSFOLDER" Name="Langs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SIDEY" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="SIDEY" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\**\*.pdb" />
        <Exclude Files="$(PublishDir)\SIDEY-Onboarding-Preview.cmd" />
      </Files>
      <ComponentRef Id="ApplicationShortcuts" />
      <ComponentRef Id="LanguageDirectory" />
    </Feature>

    <Component Id="LanguageDirectory" Directory="LANGSFOLDER" Guid="9A14E12D-D5E9-4D89-A095-9E38AA9A9C3E">
      <CreateFolder />
    </Component>

    <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Guid="DF80A2D7-20D7-4C1C-B448-F17D27073657">
      <Shortcut
          Id="StartMenuShortcut"
          Name="SIDEY"
          Description="SIDEY ambient messenger"
          Target="[INSTALLFOLDER]SIDEY.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\SIDEY\Installer"
          Name="InstalledVersion"
          Type="string"
          Value="$(DisplayVersion)"
          KeyPath="yes" />
    </Component>

    <CustomAction
        Id="RemoveStartupValue"
        Directory="SystemFolder"
        ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v SIDEY /f"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />
    <InstallExecuteSequence>
      <Custom
          Action="RemoveStartupValue"
          Before="RemoveFiles"
          Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
