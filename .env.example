# Sidey-dev must point to SIDEY-staging (or local Supabase), never production.
SIDEY_SUPABASE_URL=https://replace-with-sidey-staging-project.supabase.co
SIDEY_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
